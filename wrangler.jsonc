{
  "name": "kakushin",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kakushin",
      "database_id": "70c70330-1599-413f-a6e2-15feecaae1d1",
      "migrations_dir": "migrations"
    }
  ],
  // R2 (FILES -> kakushin-files) comes back on Day 2 once R2 is enabled in the dashboard.
  "vars": {
    "APP_URL": "https://kakushin.kajjabantu.workers.dev",
    "EMAIL_FROM": "Kakushin <onboarding@resend.dev>"
  }
}
