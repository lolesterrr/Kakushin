{
  "name": "kakushin",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages go through the Worker so it can fill in link-preview tags (src/lib/meta.ts). Static files skip it.
    "run_worker_first": ["/*", "!/assets/*", "!/hero/*", "!/favicon.svg", "!/og.jpg", "!/apple-touch-icon.png"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kakushin",
      "database_id": "70c70330-1599-413f-a6e2-15feecaae1d1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "kakushin-files" }
  ],
  // Per-IP sign-in limits (src/routes/auth.ts). Periods can only be 10 or 60 seconds.
  "ratelimits": [
    { "name": "AUTH_REQUEST_LIMIT", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_VERIFY_LIMIT", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Hourly job: close applications past their deadline, reminders, clean-up, push retries (src/lib/jobs.ts).
  "triggers": { "crons": ["0 * * * *"] },
  // Results emails and pushes go through this queue so they reach everyone (src/lib/outbox.ts).
  // Create it once per account: npx wrangler queues create kakushin-outbox
  "queues": {
    "producers": [{ "binding": "OUTBOX", "queue": "kakushin-outbox" }],
    "consumers": [{ "queue": "kakushin-outbox", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5 }]
  },
  "vars": {
    "APP_URL": "https://kakushin.dpdns.org",
    "EMAIL_FROM": "Kakushin <hello@kakushin.dpdns.org>",
    // Turnstile is on once the TURNSTILE_SECRET secret also exists. The site key is public.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF-y0jx3QbNi20hH",
    "TURNSTILE_HOSTNAMES": "kakushin.dpdns.org"
  }
}
