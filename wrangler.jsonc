{
  "name": "kakushin",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kakushin",
      "database_id": "REPLACE_AFTER_d1_create",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "kakushin-files" }
  ],
  "vars": {
    "APP_URL": "http://localhost:8787",
    "EMAIL_FROM": "Kakushin <onboarding@resend.dev>"
  }
}
